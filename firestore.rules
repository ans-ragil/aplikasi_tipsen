rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// TIPSEN — Security Rules Cloud Firestore (Minggu 10 — dasar otorisasi)
//
// Aturan dasar sesuai modul: hanya pengguna yang SUDAH LOGIN (Firebase Auth)
// yang boleh membaca dan menulis data ke seluruh collection:
//   users       — profil pengguna (Create saat daftar/masuk)
//   lokasi      — master lokasi kantor (auto-seed, Read real-time)
//   presensi    — catatan kehadiran per hari (Create Clock In, Read real-time)
//
// Tanpa login → permission-denied (teruji pada Tabel Uji kasus 5).
// Pembatasan per-peran (karyawan vs admin HC) diperketat pada Minggu 11
// bersama fitur Update & Delete.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
